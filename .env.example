# Copy to .env (never commit .env). Used by docker-compose and the backend.

# PostgreSQL (docker compose)
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop
POSTGRES_DB=brightloop
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://brightloop:brightloop@localhost:5432/brightloop
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
